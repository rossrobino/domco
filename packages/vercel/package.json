{
	"name": "@domcojs/vercel",
	"description": "domco Vercel adapter",
	"version": "3.2.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rossrobino/domco.git"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"CHANGELOG.md",
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"dev": "tsc --watch -p tsconfig.build.json",
		"build:clean": "rm -rf ./dist",
		"build:js": "tsc -p tsconfig.build.json",
		"build": "npm run build:clean && npm run build:js"
	},
	"dependencies": {
		"domco": "^5.2.0"
	}
}
